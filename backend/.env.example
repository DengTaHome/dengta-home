SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_secret_key
SUPABASE_ANON_KEY=sb_publishable_your_anon_key
AUTH_REQUIRED=false
INITIAL_OWNER_EMAIL=
PORT=3000
FRONTEND_URL=http://localhost:5173
PUSH_SECRET=replace_with_a_long_random_string

# Multi-user background jobs stay disabled until migrations 012-014 and the
# tenant-isolation rehearsal pass. Keep the trigger secret server-side only.
BACKGROUND_JOBS_ENABLED=false
BACKGROUND_JOB_TRIGGER_SECRET=
BACKGROUND_WORKER_ID=
BACKGROUND_JOB_CONCURRENCY=4
BACKGROUND_JOB_BATCH_SIZE=10
BACKGROUND_JOB_LEASE_SECONDS=300
BACKGROUND_JOB_MAX_ATTEMPTS=5
BACKGROUND_JOB_RETRY_BASE_SECONDS=30
BACKGROUND_JOB_RETRY_MAX_SECONDS=3600
BACKGROUND_JOB_TICK_BUDGET_MS=45000

# 投屏配对密钥和媒体加密密钥。缺失时配对与加密不可用，但不会崩溃。
CAST_PAIRING_SECRET=
CAST_MEDIA_ENCRYPTION_KEY=

# 供应商、地址、密钥和默认模型由每个登录账号在新版“多供应商 API 控制台”中自定义。
# 部署环境不提供全局聊天供应商锁；每个账号的活动接口相互隔离。

# hervoice 语音分析服务。DengTa home 只在内存中转发音频，不在本后端落盘。
HERVOICE_URL=
HERVOICE_SECRET=
HERVOICE_TIMEOUT_MS=90000
VOICE_RATE_LIMIT_WINDOW_MS=60000
VOICE_RATE_LIMIT_MAX=6

# 无密钥的 Open-Meteo 天气代理。只在用户主动开启定位后调用。
WEATHER_RATE_LIMIT_WINDOW_MS=600000
WEATHER_RATE_LIMIT_MAX=30

# MiniMax 自然语音。密钥只放在部署平台环境变量，不要提交到 GitHub。
# 未配置时 App 会自动退回手机系统朗读，文字聊天不受影响。
EXPRESSIVE_TTS_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_TTS_URL=https://api.minimax.io/v1/t2a_v2
MINIMAX_TTS_MODEL=speech-2.8-turbo
# 必填：从 MiniMax 控制台复制系统音色或已克隆音色的 voice_id。
MINIMAX_TTS_VOICE_ID=
MINIMAX_TTS_SPEED=1
MINIMAX_TTS_VOLUME=1
MINIMAX_TTS_PITCH=0
# 可选二次调音：深沉/明亮、强劲/柔和、饱满/清脆，范围均为 -100 到 100。
MINIMAX_TTS_VOICE_MODIFY_PITCH=0
MINIMAX_TTS_VOICE_MODIFY_INTENSITY=0
MINIMAX_TTS_VOICE_MODIFY_TIMBRE=0
# 可选且只允许一个：spacious_echo / auditorium_echo / lofi_telephone / robotic
MINIMAX_TTS_VOICE_MODIFY_SOUND_EFFECT=
# auto 表示不发送 emotion，让 MiniMax 根据整段文字自动选择情绪。
# fluent/whisper 只与 speech-2.6-hd、speech-2.6-turbo 兼容。
MINIMAX_TTS_EMOTION=auto
EXPRESSIVE_TTS_TIMEOUT_MS=45000
EXPRESSIVE_TTS_MAX_CHARS=3000
EXPRESSIVE_TTS_RATE_LIMIT_WINDOW_MS=60000
EXPRESSIVE_TTS_RATE_LIMIT_MAX=12
# 新回复会获得短期、会话绑定的语音票据；历史接口不会返回票据。
# 留空时使用 SUPABASE_SECRET_KEY 做域隔离派生，不需要在 App 输入口令。
EXPRESSIVE_TTS_ACCESS_SECRET=
EXPRESSIVE_TTS_TOKEN_TTL_SECONDS=600
# 相同回复在票据有效期内重复播放会命中内存缓存，不会重复调用 MiniMax。
EXPRESSIVE_TTS_CACHE_MAX_ENTRIES=24
EXPRESSIVE_TTS_CACHE_MAX_BYTES=25165824

# 可连接任意供应商部署的 Ombre Brain。未购买服务器时保持留空。
OMBRE_BRAIN_URL=
OMBRE_DASHBOARD_URL=
OMBRE_DASHBOARD_PASSWORD=
OMBRE_DASHBOARD_TIMEOUT_MS=8000
OMBRE_MCP_TOKEN=

# 通用 MCP 设备中心。MCP_ENCRYPTION_KEY 至少 32 个字符，只用于加密设备 Token。
# MCP 管理页面不再要求输入口令；MCP_ADMIN_SECRET 仅为旧部署和多接口控制台回退兼容。
# 环境变量只放在 Render，不要写进网页、GitHub 或备份 ZIP。
MCP_ADMIN_SECRET=
MCP_ENCRYPTION_KEY=
MCP_DEVICE_TIMEOUT_MS=12000
