+def _write_tool(fn):
+    """Reject mutation tools unless the operator explicitly opts in."""
+    @functools.wraps(fn)
+    async def wrapped(*args, **kwargs):
+        if os.environ.get("X_MCP_READ_ONLY", "1") != "0":
+            return "Error: X MCP is read-only; set X_MCP_READ_ONLY=0 to enable writes."
+        return await fn(*args, **kwargs)
+    return wrapped
 
 
