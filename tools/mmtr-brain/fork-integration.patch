+# MMTR × kiwi P1：脑层 schema / 回填 / 每日巩固（默认开启，MMTR_P1_ENABLED=0 关闭）
+try:
+    from mmtr_brain import p1 as mmtr_p1
+except Exception:  # pragma: no cover - 移植模块缺失时保持旧行为
+    mmtr_p1 = None
+
+
+def mmtr_p1_enabled() -> bool:
+    return os.getenv("MMTR_P1_ENABLED", "1") != "0"
+
+
+# 每进程只对每个 schema 做一次 P1 补列/建表：启动迁移是一次性成本，
+# 不能每个租户请求都跑 20+ 次 information_schema 查询（复审 B：26→49 查询/请求）。
+_mmtr_p1_ready_schemas: set = set()
+
+
+async def _mmtr_p1_memory_ready(conn) -> bool:
+    """当前请求 schema 的 memories 是否已有 floor_level 列（P1 未启用/未迁移时 False）。"""
+    if not (mmtr_p1_enabled() and mmtr_p1 is not None):
+        return False
+    schema = get_tenant_schema() or "public"
+    try:
+        return bool(
+            await conn.fetchval(
+                """
+                SELECT EXISTS (
+                    SELECT 1 FROM information_schema.columns
+                    WHERE table_schema = $1 AND table_name = 'memories'
+                      AND column_name = 'floor_level'
+                )
+                """,
+                schema,
+            )
+        )
+    except Exception:
+        return False
+
+
+async def _mmtr_p1_ensure_schema(conn, schema: str) -> None:
+    if not (mmtr_p1_enabled() and mmtr_p1 is not None):
+        return
+    if schema in _mmtr_p1_ready_schemas:
+        return
+    try:
+        await mmtr_p1.apply_p1_schema(conn, schema, create_indexes=False)
+        _mmtr_p1_ready_schemas.add(schema)
+    except Exception as exc:
+        # 不缓存失败：下次请求/启动再试（失败只告警，不影响租户请求）
+        print(f"⚠️ [{schema}] MMTR P1 schema 应用失败（稍后重试）：{type(exc).__name__}: {exc}")
+
