+async def _run_mmtr_consolidate_once(schema: str, label: str) -> None:
+    """MMTR P1 每日巩固（关系回归/承诺判定/压缩阶梯）。
+
+    调用方已持有该租户的 run_memory_job 锁；这里失败只告警，不影响日整理。
+    需要 MMTR_P1_ENABLED 与 MMTR_P1_CONSOLIDATE_ENABLED 同时开启。
+    """
+    if os.getenv("MMTR_P1_ENABLED", "1") == "0":
+        return
+    if os.getenv("MMTR_P1_CONSOLIDATE_ENABLED", "1") == "0":
+        return
+    try:
+        from database import get_pool
+        from mmtr_brain import p1 as mmtr_p1
+
+        pool = await get_pool()
+        async with pool.acquire() as conn:
+            # 老租户可能从未发过请求（P1 表未建）：每日任务先惰性升级
+            if not (await conn.fetchval(
+                "SELECT EXISTS (SELECT 1 FROM information_schema.tables "
+                "WHERE table_schema=$1 AND table_name='relation_state')",
+                schema,
+            )):
+                await mmtr_p1.apply_p1_schema(conn, schema, create_indexes=False)
+            summary = await mmtr_p1.consolidate_schema(
+                conn,
+                schema,
+                datetime.now(timezone.utc).timestamp() * 1000.0,
+            )
+        print(
+            f"🧠 [{label}] MMTR 巩固：回填 {summary.get('backfilled', 0)} 条，"
+            f"压缩 {len(summary.get('compressed', []))} 条，"
+            f"承诺 broken {summary.get('promises_broken', 0)}，"
+            f"surfaced {summary.get('promises_surfaced', 0)}"
+        )
+    except Exception as exc:
+        print(f"⚠️ [{label}] MMTR 巩固失败：{type(exc).__name__}: {exc}")
+
