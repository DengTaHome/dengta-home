# 环境变量模板：复制为 .env.local 使用（.env.local 已 gitignore，不放仓库）。
# 所有 VITE_ 前缀的值都会打进前端产物，对浏览器可见，只能放公开值。

# 后端 API 地址
VITE_API_URL=http://localhost:3000

# 公开认证（Supabase 登录）—— 缺失时 AuthGate 显示「登录服务尚未接通」，且 npm run build:web 校验失败
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_anon_key

# 邮箱验证 / 密码重置的回跳地址（指向前端自身，生产用正式域名）
VITE_PUBLIC_AUTH_REDIRECT_URL=http://localhost:5173
